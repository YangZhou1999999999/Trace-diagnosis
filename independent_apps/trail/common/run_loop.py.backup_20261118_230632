import time
from typing import Any, Callable, Dict, Iterable, List, Optional, Set
import traceback
from .io import checkpoint_set_item, load_checkpoint, processed_success_indices, save_checkpoint
from .labels import extract_eval_labels, leakage_audit, strip_eval_labels
from .llm import trace_audit_context


DiagnoseFn = Callable[[Dict[str, Any]], Dict[str, Any]]
BuildRecordFn = Callable[[Dict[str, Any], Dict[str, Any], int], Dict[str, Any]]


def _usage_delta(llm_server: Any, before: Optional[Dict[str, Any]]) -> Dict[str, Any]:
    if llm_server is None or before is None:
        return {
            "llm_requests": 0,
            "api_attempts": 0,
            "llm_failed_requests": 0,
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
            "llm_request_seconds": 0.0,
            "reported_usage_responses": 0,
            "schema_validation_failures": 0,
            "incomplete_outputs": 0,
            "max_token_retries": 0,
            "refusals": 0,
            "token_usage_available": False,
            "token_usage_complete": False,
        }

    after = llm_server.usage_snapshot()

    def delta(key: str) -> Any:
        return after.get(key, 0) - before.get(key, 0)

    reported_usage = delta("reported_usage_count")
    request_count = delta("request_count")
    return {
        "llm_requests": request_count,
        "api_attempts": delta("api_attempts"),
        "llm_failed_requests": delta("failed_request_count"),
        "prompt_tokens": delta("prompt_tokens"),
        "completion_tokens": delta("completion_tokens"),
        "total_tokens": delta("total_tokens"),
        "llm_request_seconds": round(delta("request_seconds"), 4),
        "reported_usage_responses": reported_usage,
        "schema_validation_failures": delta("schema_validation_failure_count"),
        "incomplete_outputs": delta("incomplete_output_count"),
        "max_token_retries": delta("max_token_retry_count"),
        "refusals": delta("refusal_count"),
        "token_usage_available": reported_usage > 0,
        "token_usage_complete": request_count > 0 and reported_usage == request_count,
    }


def run_graph_diagnosis(
    *,
    graphs: List[Dict[str, Any]],
    checkpoint_file: str,
    diagnose_one: DiagnoseFn,
    llm_server: Optional[Any] = None,
    build_record: Optional[BuildRecordFn] = None,
    end: Optional[int] = None,
    selected_graph_indices: Optional[Iterable[int]] = None,
    include_ground_truth: bool = True,
    include_eval_labels: bool = False,
    run_fingerprint: Optional[str] = None,
    completion_predicate: Optional[Callable[[Dict[str, Any]], bool]] = None,
    failed_record_metadata: Optional[
        Callable[[BaseException, Dict[str, Any]], Dict[str, Any]]
    ] = None,
) -> List[Dict[str, Any]]:
    graph_count = len(graphs)
    if end is not None and end < 0:
        raise ValueError("end must be non-negative")
    if selected_graph_indices is None:
        selected: Set[int] = set(range(graph_count))
    else:
        selected = {int(index) for index in selected_graph_indices}
        invalid = selected - set(range(graph_count))
        if invalid:
            raise ValueError(f"selected_graph_indices contains out-of-range indices: {sorted(invalid)}")
    selected_order = sorted(selected)
    if end is not None:
        selected = set(selected_order[:end])
    result = load_checkpoint(checkpoint_file)
    if run_fingerprint is not None:
        for index, item in enumerate(result):
            if item is None:
                continue
            saved = item.get("run_fingerprint") if isinstance(item, dict) else None
            if saved != run_fingerprint:
                raise ValueError(
                    "Checkpoint fingerprint mismatch at record "
                    f"{index}; refusing to resume an unverified or different TRAIL configuration."
                )
    success_indices = processed_success_indices(
        result, completion_predicate=completion_predicate,
    )

    print(f"Loaded {len(selected)} selected graph records from {graph_count} total graphs.")
    if result:
        print(f"Existing checkpoint detected with {len(result)} records.")

    for i, graph in enumerate(graphs):
        if i not in selected:
            continue
        if i in success_indices:
            previous = result[i] if i < len(result) else None
            if not isinstance(previous, dict) or previous.get("trace_id") == graph.get("trace_id"):
                continue
            print(
                f"Checkpoint graph index {i} belongs to trace {previous.get('trace_id')!r}; "
                f"rerunning for {graph.get('trace_id')!r}."
            )

        retry_text = " (retrying a previous failed record)" if i < len(result) else ""
        print(f"Diagnosing graph {i + 1}/{len(graphs)}{retry_text}...")
        usage_before = llm_server.usage_snapshot() if llm_server is not None else None
        diagnosis_started = time.perf_counter()
        stop_after_current = False

        try:
            diagnosis_graph = strip_eval_labels(graph, include_ground_truth=include_ground_truth)
            with trace_audit_context(graph.get("trace_id")):
                diagnosis = diagnose_one(diagnosis_graph)
            item = (
                build_record(graph, diagnosis, i)
                if build_record is not None
                else diagnosis
            )
            if isinstance(item, dict):
                item.setdefault("status", "OK")
                item.setdefault(
                    "leakage_audit",
                    leakage_audit(graph, include_ground_truth=include_ground_truth),
                )
                if include_eval_labels:
                    item["eval_labels"] = extract_eval_labels(graph)
        except Exception as exc:
            print(f"\n[DIAGNOSIS ERROR] Graph {i + 1}/{len(graphs)}")
            print(f"Trace ID: {graph.get('trace_id')}")
            print(f"Exception Type: {type(exc).__name__}")
            print(f"Exception Message: {exc}")

            print("\n========== FULL TRACEBACK ==========")
            traceback.print_exc()
            print("========== END TRACEBACK ==========\n")

            stop_after_current = bool(getattr(exc, "stop_run", False))
            item = {
                "status": "FAILED",
                "error": str(exc),
                "graph_index": i,
                "trace_id": graph.get("trace_id"),
                "leakage_audit": leakage_audit(
                    graph,
                    include_ground_truth=include_ground_truth,
                ),
            }
            request_denial = getattr(exc, "request_budget_denial", None)
            if isinstance(request_denial, dict):
                item["request_budget_denial"] = request_denial
            partial = getattr(exc, "shared_diagnosis_partial", None)
            if isinstance(partial, dict):
                item["partial_diagnosis"] = partial
            if failed_record_metadata is not None:
                try:
                    metadata = failed_record_metadata(exc, graph)
                except Exception as metadata_exc:
                    metadata = {
                        "status_metadata_error": type(metadata_exc).__name__,
                    }
                if isinstance(metadata, dict):
                    item.update(metadata)

        if not isinstance(item, dict):
            item = {"raw_result": item}
        if run_fingerprint is not None:
            item["run_fingerprint"] = run_fingerprint
        item["resource_usage"] = {
            "diagnosis_seconds": round(time.perf_counter() - diagnosis_started, 4),
            **_usage_delta(llm_server, usage_before),
        }
        if item["resource_usage"]["llm_failed_requests"]:
            partitioned_prediction_status = bool(
                completion_predicate is not None
                and str(item.get("local_prediction_status", "")).upper() in {"SUCCESS", "PARTIAL"}
                and str(item.get("status", "")).upper() in {"SUCCESS", "PARTIAL"}
            )
            if partitioned_prediction_status:
                # Preserve the Local/Cause Path status already derived by the
                # opted-in adapter. Failed requests remain visible in usage;
                # a failed Local request is PARTIAL when prior Local results
                # exist, while a complete Local prediction survives an
                # auxiliary scoring request failure.
                item["resource_usage"]["failed_requests_nonfatal_to_prediction"] = (
                    item["resource_usage"]["llm_failed_requests"]
                )
            else:
                item["status"] = "FAILED"
                item.setdefault("error", "One or more LLM requests failed")
        checkpoint_set_item(result, i, item)
        save_checkpoint(checkpoint_file, result)
        if stop_after_current:
            print("Diagnosis stopped by a fail-closed run-control signal; checkpoint was saved.")
            break

    print("All graph diagnosis tasks have finished, including retries.")
    return result
